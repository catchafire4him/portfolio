# Copy to .env.local for development. Never commit real values.

# PostHog project key (public by design; analytics stays off when empty).
NEXT_PUBLIC_POSTHOG_KEY=
# "us" (default) or "eu"
NEXT_PUBLIC_POSTHOG_REGION=us

# Shown as the "Start a project" link once the domain mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
