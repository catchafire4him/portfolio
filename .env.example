# Copy to .env.local for development. Never commit real values.

# PostHog project key (public by design; analytics stays off when empty).
NEXT_PUBLIC_POSTHOG_KEY=
# "us" (default) or "eu"
NEXT_PUBLIC_POSTHOG_REGION=us

# Shown as the "Start a project" link once the domain mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form email (server-only; mark Sensitive in Vercel). Without a key the
# form answers "not set up yet" and points people to the email link.
RESEND_API_KEY=
# Where inquiries go (defaults to NEXT_PUBLIC_CONTACT_EMAIL).
CONTACT_TO=
# Sender; the default works before a domain is verified in Resend.
CONTACT_FROM=
